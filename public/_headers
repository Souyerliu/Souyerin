# Cloudflare Pages 缓存头配置
# 字体文件：1 年缓存（已做内容哈希，永久不可变）
/_astro/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# JS/CSS 构建产物：1 年缓存（内容哈希保证唯一性）
/_astro/*.js
  Cache-Control: public, max-age=31536000, immutable

/_astro/*.css
  Cache-Control: public, max-age=31536000, immutable

# 图片：7 天缓存（可能会更新）
/images/*
  Cache-Control: public, max-age=604800

# Live2D 模型文件：30 天缓存
/live2d-models/*
  Cache-Control: public, max-age=2592000

# HTML 页面：不缓存，确保及时更新
/*
  Cache-Control: public, max-age=0, must-revalidate
