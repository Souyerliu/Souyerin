---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  index: number;
  isListItem?: boolean;
}

const { src, alt, index, isListItem = false } = Astro.props as Props;

// 动画延迟(仅多图轮播)
const animationDelay = isListItem ? `${index * 6}s` : "0s";

const isStringSrc = typeof src === "string";

// ---- 图片优化管线（国内访问加速）----
// 本地静态图片（ImageMetadata）走 Astro 图片管线：输出 AVIF/WebP/JPG 三种格式、
// 640~1920 多档宽度，浏览器按视口宽度与格式支持自动选择，首屏传输体积大幅下降。
// 字符串（public 路径/远程 URL）无法静态优化，保持原 <img> 兜底。
const WIDTHS = [640, 960, 1280, 1920];
const SIZES = "100vw";

let imgUrl = "";
let imgSrcset = "";
let avifSrcset: string | undefined;
let webpSrcset: string | undefined;

if (isStringSrc) {
  imgUrl = src as string;
} else {
  const image = src as ImageMetadata;
  const avif = await getImage({ src: image, widths: WIDTHS, format: "avif" });
  const webp = await getImage({ src: image, widths: WIDTHS, format: "webp" });
  const jpg = await getImage({ src: image, widths: WIDTHS, format: "jpg" });
  avifSrcset = avif.srcSet.attribute;
  webpSrcset = webp.srcSet.attribute;
  imgUrl = jpg.src;
  imgSrcset = jpg.srcSet.attribute;
}

// 只有第一张图（index=0）eager 加载，其余 lazy；单图模式维持 eager
const loading = isListItem && index !== 0 ? "lazy" : "eager";
const fetchpriority = isListItem && index !== 0 ? "low" : "high";
---

{
  isListItem ? (
    <li
      class="cover-item"
      style={`animation-delay: ${animationDelay};`}
      onmouseenter="this.classList.add('stop-animation')"
      onmouseleave="this.classList.remove('stop-animation')"
      ontouchstart="this.classList.add('stop-animation')"
      ontouchend="this.classList.remove('stop-animation')"
    >
      {
        avifSrcset ? (
          <picture class="cover-picture">
            <source type="image/avif" srcset={avifSrcset} sizes={SIZES} />
            <source type="image/webp" srcset={webpSrcset} sizes={SIZES} />
            <img
              src={imgUrl}
              srcset={imgSrcset}
              sizes={SIZES}
              alt={alt}
              class="cover-image"
              loading={loading}
              decoding="async"
              fetchpriority={fetchpriority}
              width="1920"
              height="1080"
            />
          </picture>
        ) : (
          <img
            src={imgUrl}
            alt={alt}
            class="cover-image"
            loading={loading}
            decoding="async"
            fetchpriority={fetchpriority}
            width="1920"
            height="1080"
          />
        )
      }
    </li>
  ) : avifSrcset ? (
    <picture class="cover-picture">
      <source type="image/avif" srcset={avifSrcset} sizes={SIZES} />
      <source type="image/webp" srcset={webpSrcset} sizes={SIZES} />
      <img
        src={imgUrl}
        srcset={imgSrcset}
        sizes={SIZES}
        alt={alt}
        class="single-image"
        loading="eager"
        decoding="sync"
        fetchpriority="high"
      />
    </picture>
  ) : (
    <img
      src={imgUrl}
      alt={alt}
      class="single-image"
      loading="eager"
      decoding="sync"
      fetchpriority="high"
    />
  )
}

<style>
  .cover-item {
    opacity: 0;
    height: 70vh;
    width: 100%;
    left: 0;
    top: 0;
    position: absolute;
    z-index: var(--z-base);
    overflow: hidden;
    animation: imageAnimation 36s linear infinite 0s;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .cover-item.stop-animation {
    animation-play-state: paused;
  }

  .cover-image {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* 响应式 picture 需要撑满容器，否则 img 无法继承 100% 尺寸 */
  .cover-picture {
    display: block;
    height: 100%;
    width: 100%;
  }

  .single-image {
    height: 100%;
    width: 100%;
    left: 0;
    top: 0;
    position: absolute;
    object-fit: cover;
  }

  /* 动画应用到容器上，图片本身用 object-cover 填充 */
  .cover-item :global(img) {
    transform-origin: center;
  }

  @keyframes imageAnimation {
    0% {
      opacity: 0;
      animation-timing-function: ease-in;
    }
    2% {
      opacity: 1;
    }
    8% {
      opacity: 1;
      transform: scale(1.05);
      animation-timing-function: ease-out;
    }
    17% {
      opacity: 1;
      transform: scale(1.1);
    }
    25% {
      opacity: 0;
      transform: scale(1.1);
    }
    100% {
      opacity: 0;
    }
  }
</style>
