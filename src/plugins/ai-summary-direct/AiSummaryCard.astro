---
import { readLocalAiSummary } from "@/toolkit/aiSummaryDb";

interface Props {
  hyacineArticle?: Record<string, unknown> | null;
  postId?: string;
  postTitle?: string;
  enable?: boolean;
  title?: string;
  showModel?: boolean;
}

const {
  hyacineArticle,
  postId = "",
  postTitle = "",
  enable = false,
  title = "AI 摘要",
  showModel = false,
} = Astro.props;

interface SummaryResult {
  content: string;
  model: string | null;
}

function asRecord(value: unknown): Record<string, unknown> {
  return typeof value === "object" && value !== null ? (value as Record<string, unknown>) : {};
}

function asString(value: unknown): string {
  return typeof value === "string" ? value : "";
}

function readMaterializedSummary(article: Record<string, unknown>): SummaryResult | null {
  const ai = asRecord(article.ai);
  const aiSummary = asRecord(ai.summary);
  const sdkSummary = asString(aiSummary.summary).trim();
  const frontmatterSummary =
    asString(article.ai_summary).trim() ||
    asString(article.summary).trim() ||
    asString(article.aiSummary).trim();
  const content = sdkSummary || frontmatterSummary;
  if (!content) return null;

  return {
    content,
    model: asString(aiSummary.model).trim() || asString(article.ai_model).trim() || null,
  };
}

let summary: SummaryResult | null = null;
const article = asRecord(hyacineArticle);
const encrypted = article.encrypted === true;
if (enable && !encrypted) {
  summary = readMaterializedSummary(article);
  if (!summary && postId) {
    summary = readLocalAiSummary(postId, postTitle || asString(article.title));
  }
}
---

{summary && (
  <section class="ai-summary-card" aria-label="AI 摘要">
    <div class="ai-summary-card__title">
      <i class="icon i-ri-robot-2-line" aria-hidden="true" />
      <span>{title}</span>
    </div>
    <p class="ai-summary-card__content">{summary.content}</p>
    {showModel && summary.model && (
      <div class="ai-summary-card__meta">
        <i class="icon i-ri-cpu-line" aria-hidden="true" />
        <span>{summary.model}</span>
      </div>
    )}
  </section>
)}

<style>
  .ai-summary-card {
    margin-top: 1rem;
    margin-bottom: 1rem;
    padding: 0.875rem 1rem;
    border-radius: 0.625rem;
    background: var(--grey-2);
    border: 1px solid var(--grey-3);
  }

  .ai-summary-card__title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--primary-color);
    font-weight: 600;
    margin-bottom: 0.625rem;
  }

  .ai-summary-card__title .icon {
    font-size: 1.05rem;
  }

  .ai-summary-card__content {
    margin: 0;
    line-height: 1.75;
    color: var(--text-color);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .ai-summary-card__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0.625rem;
    font-size: 0.75rem;
    color: var(--grey-5);
  }
</style>
